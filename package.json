{
  "name": "siyuan-plugin-mindmap",
  "version": "0.1.0",
  "description": "Render outline blocks (unordered / ordered / task list) as professional mind maps.",
  "private": true,
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --zip",
    "test": "node tests/run.mjs",
    "smoke": "node tests/smoke.cjs",
    "visual": "node tests/visual.mjs && node tests/visual-check.mjs",
    "live": "node tests/live.mjs",
    "live:gpu": "node tests/live-gpu.mjs",
    "kernel:shapes": "node tests/kernel/insert-shapes.mjs",
    "kernel:restore": "node tests/kernel/restore-roundtrip.mjs",
    "kernel:focus": "node tests/kernel/focus-timeline.mjs",
    "kernel:inline": "node tests/kernel/inline-coverage.mjs",
    "kernel:inline:edit": "node tests/kernel/inline-coverage.mjs edit",
    "kernel:inline:copy": "node tests/kernel/inline-coverage.mjs copy",
    "kernel:inline:links": "node tests/kernel/inline-coverage.mjs links",
    "kernel:inline:all": "node tests/kernel/inline-coverage.mjs && node tests/kernel/inline-coverage.mjs edit && node tests/kernel/inline-coverage.mjs copy && node tests/kernel/inline-coverage.mjs links",
    "kernel:image": "node tests/kernel/image-probe.mjs",
    "kernel:copy": "node tests/kernel/copy-fidelity.mjs",
    "ux:tour": "node tests/kernel/ux-tour.mjs",
    "ux:scale": "node tests/kernel/measure-scale.mjs",
    "ux:v2": "node tests/kernel/ux-v2.mjs",
    "ux:edit": "node tests/kernel/diag-edit-flow.mjs",
    "ux:reopen": "node tests/kernel/diag-reopen.mjs",
    "ux:doc": "node tests/kernel/diag-user-doc.mjs",
    "ux:frame": "node tests/kernel/diag-feedback.mjs",
    "ux:fold": "node tests/kernel/diag-fold-sync.mjs",
    "ux:migrate": "node tests/kernel/diag-migrate-layout.mjs",
    "ux:zoom": "node tests/kernel/diag-zoom-measure.mjs",
    "ux:canvas": "node tests/kernel/diag-canvas-v2.mjs",
    "ux:all": "node tests/kernel/ux-v2.mjs && node tests/kernel/diag-edit-flow.mjs && node tests/kernel/diag-reopen.mjs && node tests/kernel/diag-user-doc.mjs && node tests/kernel/diag-feedback.mjs && node tests/kernel/diag-fold-sync.mjs && node tests/kernel/diag-migrate-layout.mjs && node tests/kernel/diag-zoom-measure.mjs && node tests/kernel/diag-canvas-v2.mjs",
    "probe:unfold": "node tests/kernel/probe-unfold-api.mjs",
    "probe:fold": "node tests/kernel/probe-batch-fold.mjs",
    "probe:menu": "node tests/kernel/probe-menu.mjs",
    "probe:canvas": "node tests/kernel/introspect-v2.mjs",
    "clean:tmp": "node scripts/clean-tmp-docs.mjs",
    "clean:tmp!": "node scripts/clean-tmp-docs.mjs --yes",
    "check": "node scripts/gen-style.mjs && tsc --noEmit && node tests/run.mjs && node scripts/build.mjs --zip && node tests/smoke.cjs",
    "check:all": "npm run check && npm run visual",
    "deploy": "node scripts/deploy.mjs",
    "verify": "node scripts/verify-install.mjs",
    "typecheck": "node scripts/gen-style.mjs && tsc --noEmit",
    "icon": "node scripts/make-icon.mjs"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "mindmap",
    "outline",
    "思维导图"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.24.2",
    "siyuan": "^1.2.7",
    "typescript": "^5.7.3"
  }
}
